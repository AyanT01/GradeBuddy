# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform lock file (can be committed but often ignored in dev)
.terraform.lock.hcl

# Terraform directory
.terraform/

# Variable files that may contain sensitive data
*.tfvars
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration file
.terraformrc
terraform.rc

# Local env files
.env
.env.local
